{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sensorkit:default",
    "auth-cognito:default",
    "os:default",
    "deep-link:default",
    "stronghold:default",
    "stronghold:allow-remove-secret",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://sensing-flow-api*.satooru.dev"
        }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:read-files",
      "allow": [
        {
          "path": "$APPLOCALDATA/sensor_data/**/*"
        }
      ]
    }
  ]
}
